+-- Опыт ранга за исследования (шаг 6.2 ДД): первая победа над видом монстра и первая найденная территория.
+-- Платится один раз на профиль; порождения монстров (Monsters.Summons) видами не считаются
+function EconomyService:Explore(player, kind, id, info)
+	local p = DataService:GetProfile(player)
+	local listKey = kind == "monster" and "seenMonsters" or (kind == "territory" and "seenTerritories" or nil)
+	if not (p and listKey and type(id) == "string") then return false, 0 end
+	if kind == "monster" and MonstersCfg.Summons and MonstersCfg.Summons[id] then return false, 0 end
+	p.stats = p.stats or {}
+	local seen = p.stats[listKey] or {}
+	p.stats[listKey] = seen
+	if seen[id] then return false, 0 end
+	seen[id] = true
+	local X = Economy.ExplorationXp
+	local xp = kind == "territory" and X.territory or (info and info.elite and X.eliteType or X.monsterType)
+	xp = math.floor(tonumber(xp) or 0)
+	if xp > 0 then
+		self:AddXp(player, xp)
+		local shown = info and info.name and Locale.Name(langOf(player), info.name) or id
+		Net.Fire(player, "Notify", kind == "monster" and "explore_monster" or "explore_territory", shown, xp)
+		PlayerService:Push(player)
+	end
+	return true, xp
+end
+
+-- Игрок впервые вошёл в территорию из Economy.Territories (прямоугольник зоны из Config.Map)
+function EconomyService:CheckTerritories(player)
+	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
+	if not root then return end
+	for id, t in pairs(Economy.Territories) do
+		local zone = MapCfg[t.mapKey]
+		if zone and math.abs(root.Position.X - zone.Center.X) <= zone.Size.X / 2 and math.abs(root.Position.Z - zone.Center.Y) <= zone.Size.Y / 2 then
+			self:Explore(player, "territory", id, {name = t.name})
+		end
+	end
+end
+
+-- Лечение у своего Дома за один шаг цикла: HouseHealPerSecondPerLevel HP в секунду за уровень Дома
+function EconomyService.HouseHealPerTick(houseLevel)
+	return math.max(0, tonumber(houseLevel) or 1) * Economy.UpgradeEffects.HouseHealPerSecondPerLevel * LOOP_SECONDS
+end
+
